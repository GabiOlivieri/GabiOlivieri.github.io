---
import "@fontsource-variable/open-sans"
import "@fontsource-variable/fira-code"

import Header from "../components/Header.astro"
import Footer from "../components/Footer.astro"
import Background from "../components/Background.astro"
import { ViewTransitions } from "astro:transitions"

interface Props {
  title: string
  description: string
  image?: string
  noindex?: boolean
}

const { description, title, image = "/og-image.jpg", noindex = false } = Astro.props

const canonicalURL = new URL(Astro.url.pathname, Astro.site)
const socialImageURL = new URL(image, Astro.site)

const personJsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Gabriel Olivieri",
  url: Astro.site?.toString(),
  image: socialImageURL.toString(),
  jobTitle: "Full Stack Developer",
  description,
  sameAs: ["https://www.linkedin.com/in/gabriel-olivieri-38437b1bb/", "https://github.com/GabiOlivieri"],
  knowsAbout: [
    "Full Stack Development",
    "Identity and Access Management",
    "Cloud Computing",
    "DevOps",
    "DevSecOps",
  ],
}
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Gabriel Olivieri" />
    <link rel="canonical" href={canonicalURL} />
    {noindex ? (
      <meta name="robots" content="noindex, nofollow" />
    ) : (
      <meta name="robots" content="index, follow" />
    )}

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0a0a0a" />
    <meta name="darkreader-lock" />

    <!-- Open Graph / Facebook / WhatsApp -->
    <meta property="og:type" content="profile" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="Gabriel Olivieri" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Gabriel Olivieri — Full Stack Developer, Cloud & DevOps" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:locale:alternate" content="en_US" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageURL} />

    <!-- Datos estructurados para buscadores y asistentes de IA -->
    <script type="application/ld+json" set:html={JSON.stringify(personJsonLd)} is:inline />

    <script is:inline>
      document.documentElement.classList.add("js-reveal")
    </script>
    <ViewTransitions />
  </head>

  <body class="relative bg-paper text-ink antialiased">
    <Background />
    <Header />
    <slot />
    <Footer />
    <style is:global>
      /* ── Tokens monocromos ────────────────────────────────────────── */
      :root {
        color-scheme: light dark;

        --paper: 250 250 250;
        --surface: 255 255 255;
        --ink: 10 10 10;
        --muted: 82 82 82;
        --faint: 115 115 115;
        --line: 224 224 224;
      }

      .dark {
        --paper: 8 8 8;
        --surface: 20 20 20;
        --ink: 250 250 250;
        --muted: 163 163 163;
        --faint: 115 115 115;
        --line: 38 38 38;
      }

      html {
        font-family: "Open Sans Variable", "Open Sans", system-ui, sans-serif;
        scroll-behavior: smooth;
      }

      body {
        display: flex;
        flex-direction: column;
        min-height: 100vh;
        overscroll-behavior: none;
      }

      /* Todo lo tipográficamente "de código" usa Fira Code. */
      .font-code,
      code,
      kbd,
      samp,
      pre {
        font-family: "Fira Code Variable", "Fira Code", ui-monospace, SFMono-Regular, monospace;
        font-feature-settings: "calt" 1;
      }

      /* Etiqueta de sección / metadato: mono, chico, espaciado. */
      .label-code {
        font-family: "Fira Code Variable", "Fira Code", ui-monospace, monospace;
        font-size: 0.75rem;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: rgb(var(--faint));
      }

      ::selection {
        background: rgb(var(--ink));
        color: rgb(var(--paper));
      }

      :focus-visible {
        outline: 2px solid rgb(var(--ink));
        outline-offset: 3px;
      }

      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }
      }

      /* ── Animaciones de entrada ───────────────────────────────────── */
      @keyframes fade-in-up {
        from {
          opacity: 0;
          translate: 0 16px;
        }
        to {
          opacity: 1;
          translate: 0 0;
        }
      }

      .anim-fade-in {
        animation: fade-in-up 0.6s cubic-bezier(0.22, 1, 0.36, 1) both;
      }
      .anim-delay-1 { animation-delay: 100ms; }
      .anim-delay-2 { animation-delay: 200ms; }
      .anim-delay-3 { animation-delay: 300ms; }
      .anim-delay-4 { animation-delay: 400ms; }
      .anim-delay-5 { animation-delay: 500ms; }

      /* ── Reveal al hacer scroll ───────────────────────────────────
         Solo esconde si el JS llegó a marcar .js-reveal, para que sin
         JavaScript el contenido se vea igual. */
      .js-reveal [data-reveal] {
        opacity: 0;
        translate: 0 20px;
        transition:
          opacity 0.7s cubic-bezier(0.22, 1, 0.36, 1),
          translate 0.7s cubic-bezier(0.22, 1, 0.36, 1);
        transition-delay: var(--reveal-delay, 0ms);
      }

      .js-reveal [data-reveal].is-revealed {
        opacity: 1;
        translate: 0 0;
      }

      @media (prefers-reduced-motion: reduce) {
        .anim-fade-in {
          animation: none !important;
        }

        .js-reveal [data-reveal] {
          transition: none !important;
        }

        .anim-fade-in,
        .js-reveal [data-reveal] {
          opacity: 1 !important;
          translate: none !important;
        }
      }
    </style>

    <script>
      /** Escalonado entre hermanos de un mismo [data-reveal-group]. */
      const STEP_MS = 90
      const MAX_STEPS = 6

      const setupReveal = () => {
        const items = Array.from(document.querySelectorAll<HTMLElement>("[data-reveal]"))
        if (!items.length) return

        const revealAll = () => items.forEach((el) => el.classList.add("is-revealed"))
        const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches

        if (reduceMotion || !("IntersectionObserver" in window)) {
          revealAll()
          return
        }

        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return
              entry.target.classList.add("is-revealed")
              observer.unobserve(entry.target)
            })
          },
          // El margen inferior negativo dispara la animación un poco antes de
          // que el elemento toque el borde de la pantalla.
          { rootMargin: "0px 0px -12% 0px", threshold: 0 }
        )

        items.forEach((el) => {
          const group = el.closest("[data-reveal-group]")

          if (group) {
            const index = Array.from(group.querySelectorAll("[data-reveal]")).indexOf(el)
            if (index > 0) {
              el.style.setProperty("--reveal-delay", `${Math.min(index, MAX_STEPS) * STEP_MS}ms`)
            }
          }

          observer.observe(el)
        })

        // Red de seguridad: si el observer no llegó a marcar lo que ya está en
        // pantalla, se revela igual. Vale más ver el contenido que la animación.
        window.setTimeout(() => {
          items.forEach((el) => {
            if (el.classList.contains("is-revealed")) return
            if (el.getBoundingClientRect().top < window.innerHeight) {
              el.classList.add("is-revealed")
            }
          })
        }, 2500)

        document.addEventListener("astro:before-swap", () => observer.disconnect(), { once: true })
      }

      const safeSetupReveal = () => {
        try {
          setupReveal()
        } catch {
          // Ante cualquier fallo, el contenido se muestra sin animación.
          document.querySelectorAll("[data-reveal]").forEach((el) => el.classList.add("is-revealed"))
        }
      }

      safeSetupReveal()
      document.addEventListener("astro:after-swap", safeSetupReveal)
    </script>
  </body>
</html>
