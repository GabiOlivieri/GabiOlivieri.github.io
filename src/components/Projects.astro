---
import GitHub from "./icons/GitHub.astro"
import ExternalLink from "./icons/ExternalLink.astro"
import LinkButton from "./LinkButton.astro"
import projectsData from "@/data/projects.json"
import fs from "node:fs"
import path from "node:path"

/**
 * Las capturas se resuelven en build: si el archivo todavía no está en /public,
 * la tarjeta muestra un placeholder en vez de una imagen rota.
 */
const hasImage = (src: string) =>
  Boolean(src) && fs.existsSync(path.join(process.cwd(), "public", src))

/** Etiqueta legible por tag. El color ya no forma parte del sistema. */
const TAG_LABELS: Record<string, string> = {
  NEXT: "Next.js",
  TAILWIND: "Tailwind CSS",
  WEB: "Web",
  MOBILE: "Multiplataforma",
  UTN: "UTN FRBA",
  SECURITY: "Seguridad",
  LMS: "LMS",
  WORDPRESS: "WordPress",
  PROJECT: "Proyecto",
  HEALTH: "Salud",
  AI: "IA",
}

const FILTERS = [
  { id: "all", label: "Todos" },
  { id: "ia", label: "IA" },
  { id: "web", label: "Web" },
  { id: "mobile", label: "Mobile" },
  { id: "cloud", label: "Cloud / Seguridad" },
]

const PROJECTS = projectsData.map((project, index) => ({
  ...project,
  number: String(index + 1).padStart(2, "0"),
  hasImage: hasImage(project.image),
  tagLabels: project.tags.map((key) => ({ key, name: TAG_LABELS[key] ?? key })),
  categories: [
    ...(project.tags.includes("AI") ? ["ia"] : []),
    ...(project.tags.includes("WEB") || project.tags.includes("WORDPRESS") || project.tags.includes("LMS")
      ? ["web"]
      : []),
    ...(project.tags.includes("MOBILE") ? ["mobile"] : []),
    ...(project.tags.includes("SECURITY") ? ["cloud"] : []),
  ],
}))
---

<div class="flex flex-col gap-y-10" id="projects-filter-root">
  <div
    class="flex flex-wrap items-center gap-2"
    role="tablist"
    aria-label="Filtrar proyectos por categoría"
    data-i18n-attr="aria-label:projects.filterAria"
    data-reveal
  >
    {
      FILTERS.map((filter) => (
        <button
          type="button"
          data-filter={filter.id}
          class="projects-filter-btn rounded-full border border-line px-4 py-1.5 font-mono text-[13px] text-muted transition hover:border-ink hover:text-ink"
          data-i18n={`projects.filter.${filter.id}`}
        >
          {filter.label}
        </button>
      ))
    }
  </div>

  <p
    id="projects-empty-state"
    class="hidden font-mono text-sm text-faint"
    data-i18n="projects.emptyState"
  >
    No hay proyectos en esta categoría por ahora.
  </p>

  <div class="flex flex-col divide-y divide-line border-y border-line" id="projects-list">
    {
      PROJECTS.map((project) => (
        <article
          class="project-item group grid gap-6 py-10 md:grid-cols-2 md:gap-12"
          data-reveal
          data-categories={project.categories.join(",") || "uncategorized"}
        >
          <div class="order-2 flex flex-col justify-center md:order-1">
            <p class="label-code flex flex-wrap items-center gap-x-2 gap-y-1">
              <span class="text-ink">{project.number}</span>
              {project.year && <><span aria-hidden="true">/</span><span>{project.year}</span></>}
              {project.org && <><span aria-hidden="true">/</span><span>{project.org}</span></>}
            </p>

            <h3 class="mt-3 text-balance text-2xl font-bold tracking-tight text-ink">
              <span data-i18n={`projects.items.${project.id}.title`}>{project.title}</span>
            </h3>

            {project.role && (
              <p class="mt-1.5 font-mono text-sm text-muted">
                <span data-i18n={`projects.items.${project.id}.role`}>{project.role}</span>
              </p>
            )}

            <p class="mt-4 max-w-prose text-pretty leading-relaxed text-muted">
              <span data-i18n={`projects.items.${project.id}.description`}>{project.description}</span>
            </p>

            {project.stack.length > 0 && (
              <ul class="mt-5 flex flex-wrap gap-1.5">
                {project.stack.map((tech) => (
                  <li class="rounded-md border border-line px-2 py-0.5 font-mono text-[11px] text-muted">
                    {tech}
                  </li>
                ))}
              </ul>
            )}

            <ul class="mt-3 flex flex-wrap gap-x-3 gap-y-1">
              {project.tagLabels.map((tag) => (
                <li class="font-mono text-[11px] uppercase tracking-[0.12em] text-faint">
                  #<span data-i18n={`projects.tags.${tag.key}`}>{tag.name}</span>
                </li>
              ))}
            </ul>

            {(project.github || project.link) && (
              <footer class="mt-6 flex flex-wrap items-center gap-3">
                {project.github && (
                  <LinkButton href={project.github}>
                    <GitHub class="size-4" />
                    <span data-i18n="projects.code">Código</span>
                  </LinkButton>
                )}
                {project.link && (
                  <LinkButton href={project.link}>
                    <ExternalLink class="size-4" />
                    <span data-i18n="projects.preview">Ver en vivo</span>
                  </LinkButton>
                )}
              </footer>
            )}
          </div>

          <div class="order-1 md:order-2">
            <div class="overflow-hidden rounded-2xl border border-line bg-surface/60">
              {project.hasImage ? (
                <img
                  alt={project.title}
                  loading="lazy"
                  src={project.image}
                  class="aspect-[16/10] w-full object-contain object-center p-3 grayscale transition duration-500 group-hover:grayscale-0 md:group-hover:scale-[1.015]"
                />
              ) : (
                <div class="project-placeholder grid aspect-[16/10] w-full place-items-center">
                  <span class="font-mono text-4xl font-semibold text-faint/50">{project.number}</span>
                </div>
              )}
            </div>
          </div>
        </article>
      ))
    }
  </div>
</div>

<script>
  document.addEventListener("astro:page-load", () => {
    const root = document.getElementById("projects-filter-root")
    if (!root) return

    const buttons = root.querySelectorAll<HTMLButtonElement>(".projects-filter-btn")
    const items = root.querySelectorAll<HTMLElement>(".project-item")
    const emptyState = document.getElementById("projects-empty-state")

    const applyFilter = (filter: string) => {
      let visibleCount = 0

      items.forEach((item) => {
        const categories = (item.dataset.categories || "").split(",")
        const shouldShow = filter === "all" || categories.includes(filter)
        item.classList.toggle("hidden", !shouldShow)
        if (shouldShow) visibleCount += 1
      })

      emptyState?.classList.toggle("hidden", visibleCount > 0)
      buttons.forEach((btn) => btn.classList.toggle("is-active", btn.dataset.filter === filter))
    }

    buttons.forEach((button) => {
      button.addEventListener("click", () => applyFilter(button.dataset.filter || "all"))
    })

    applyFilter("all")
  })
</script>

<style>
  /* Placeholder de captura: la misma grilla de puntos del fondo, en chico. */
  .project-placeholder {
    background-image: radial-gradient(rgb(var(--line)) 1.5px, transparent 1.5px);
    background-size: 14px 14px;
  }

  .projects-filter-btn.is-active {
    @apply border-ink bg-ink text-paper;
  }
</style>
