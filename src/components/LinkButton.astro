---
const { href } = Astro.props
---

<a
  target="_blank"
  rel="noopener noreferrer"
  href={href}
  class="inline-flex max-w-fit items-center justify-center gap-2 rounded-full border border-line px-4 py-2 font-mono text-sm text-ink transition hover:border-ink hover:bg-ink hover:text-paper"
>
  <slot />
</a>
