---
import ThemeToggle from "./ThemeToggle.astro"
import es from "@/data/i18n/es.json"
import en from "@/data/i18n/en.json"

const translations = { es, en }

const navItems = [
  { title: es.nav.servicios, i18nKey: "nav.servicios", label: "servicios", url: "/#servicios" },
  { title: es.nav.experiencia, i18nKey: "nav.experiencia", label: "experiencia", url: "/#experiencia" },
  { title: es.nav.proyectos, i18nKey: "nav.proyectos", label: "proyectos", url: "/#proyectos" },
  { title: es.nav.certificaciones, i18nKey: "nav.certificaciones", label: "certificaciones", url: "/#certificaciones" },
  { title: es.nav.stack, i18nKey: "nav.stack", label: "stack", url: "/#stack" },
  { title: es.nav.formacion, i18nKey: "nav.formacion", label: "formacion", url: "/#formacion" },
]
---

<header class="fixed top-0 z-20 mt-4 w-full px-4">
  <nav
    class="header-nav mx-auto hidden w-max items-center justify-center gap-x-0.5 rounded-full border border-transparent px-2 py-1.5 font-mono text-[13px] text-muted md:flex"
  >
    {
      navItems.map((link) => (
        <a
          class="nav-link relative block rounded-full px-3 py-1.5 transition-colors duration-200 hover:text-ink"
          aria-label={link.label}
          href={link.url}
        >
          <span data-i18n={link.i18nKey}>{link.title}</span>
        </a>
      ))
    }
    <div class="ml-2 inline-flex gap-0.5 border-l border-line pl-2">
      <button
        type="button"
        class="lang-btn rounded-full px-2 py-1 font-mono text-[11px] font-semibold transition-colors hover:text-ink"
        data-lang-switch="es"
        data-i18n="lang.es"
        aria-label="Cambiar a español">ES</button
      >
      <button
        type="button"
        class="lang-btn rounded-full px-2 py-1 font-mono text-[11px] font-semibold transition-colors hover:text-ink"
        data-lang-switch="en"
        data-i18n="lang.en"
        aria-label="Switch to English">EN</button
      >
    </div>
    <div class="ml-2 border-l border-line pl-2">
      <ThemeToggle />
    </div>
  </nav>

  <details class="mobile-nav ml-auto w-fit md:hidden">
    <summary
      class="mobile-toggle grid size-11 list-none place-items-center rounded-full border border-line bg-surface/90 text-ink shadow-sm backdrop-blur-md"
      aria-label={es.nav.openMenu}
      data-i18n-attr="aria-label:nav.openMenu"
    >
      <span class="hamburger" aria-hidden="true">
        <span class="line line-1"></span>
        <span class="line line-2"></span>
        <span class="line line-3"></span>
      </span>
    </summary>
    <nav
      class="mobile-menu mt-2 w-[min(18rem,calc(100vw-2rem))] rounded-2xl border border-line bg-surface/95 p-2 text-muted shadow-xl backdrop-blur-md"
    >
      {
        navItems.map((link) => (
          <a
            class="nav-link block rounded-xl px-3 py-2.5 font-mono text-sm transition-colors duration-200 hover:text-ink"
            aria-label={link.label}
            href={link.url}
          >
            <span data-i18n={link.i18nKey}>{link.title}</span>
          </a>
        ))
      }
      <div class="mt-2 flex items-center justify-between border-t border-line pt-2">
        <span class="label-code" data-i18n="lang.selector">Idioma</span>
        <div class="inline-flex gap-1">
          <button
            type="button"
            class="lang-btn rounded-full px-2 py-1 font-mono text-[11px] font-semibold transition-colors hover:text-ink"
            data-lang-switch="es"
            data-i18n="lang.es"
            aria-label="Cambiar a español">ES</button
          >
          <button
            type="button"
            class="lang-btn rounded-full px-2 py-1 font-mono text-[11px] font-semibold transition-colors hover:text-ink"
            data-lang-switch="en"
            data-i18n="lang.en"
            aria-label="Switch to English">EN</button
          >
        </div>
      </div>
      <div class="mt-2 flex justify-end border-t border-line pt-2">
        <ThemeToggle />
      </div>
    </nav>
  </details>
</header>

<script is:inline define:vars={{ translations }}>
  document.addEventListener("astro:page-load", () => {
    const sections = Array.from(document.querySelectorAll("section[id]"))
    const navItems = document.querySelectorAll("header nav a")
    const mobileNav = document.querySelector(".mobile-nav")
    const langButtons = document.querySelectorAll("[data-lang-switch]")

    const getValueByPath = (obj, path) => path.split(".").reduce((acc, key) => acc?.[key], obj)

    const setLanguageButtonState = (lang) => {
      langButtons.forEach((button) => {
        button.classList.toggle("is-active", button.dataset.langSwitch === lang)
      })
    }

    const applyTranslations = (lang) => {
      const dict = translations[lang] ?? translations.es

      document.documentElement.lang = lang
      document.querySelectorAll("[data-i18n]").forEach((element) => {
        const key = element.getAttribute("data-i18n")
        if (!key) return
        const value = getValueByPath(dict, key)
        if (typeof value === "string") element.textContent = value
      })

      document.querySelectorAll("[data-i18n-html]").forEach((element) => {
        const key = element.getAttribute("data-i18n-html")
        if (!key) return
        const value = getValueByPath(dict, key)
        if (typeof value === "string") element.innerHTML = value
      })

      document.querySelectorAll("[data-i18n-attr]").forEach((element) => {
        const descriptor = element.getAttribute("data-i18n-attr")
        if (!descriptor) return
        const [attrName, key] = descriptor.split(":")
        const value = getValueByPath(dict, key)
        if (attrName && typeof value === "string") element.setAttribute(attrName, value)
      })

      if (typeof dict.page?.title === "string") document.title = dict.page.title

      const descriptionMeta = document.querySelector('meta[name="description"]')
      if (descriptionMeta && typeof dict.page?.description === "string") {
        descriptionMeta.setAttribute("content", dict.page.description)
      }

      setLanguageButtonState(lang)
    }

    const detectLanguage = () => {
      const savedLanguage = localStorage.getItem("site-language")
      if (savedLanguage === "es" || savedLanguage === "en") return savedLanguage
      return navigator.language.toLowerCase().startsWith("en") ? "en" : "es"
    }

    applyTranslations(detectLanguage())

    const setActiveNavItem = (sectionId) => {
      navItems.forEach((item) => {
        item.classList.toggle("is-active", item.getAttribute("aria-label") === sectionId)
      })
    }

    const header = document.querySelector("header")

    const getActivationOffset = () => {
      const headerHeight = header?.getBoundingClientRect().height ?? 0
      return headerHeight + window.innerHeight * 0.2
    }

    const updateActiveSection = () => {
      if (!sections.length) return

      const scrollLine = window.scrollY + getActivationOffset()
      let activeSectionId = sections[0].id

      sections.forEach((section) => {
        if (section.offsetTop <= scrollLine) activeSectionId = section.id
      })

      setActiveNavItem(activeSectionId)
    }

    updateActiveSection()
    window.addEventListener("scroll", updateActiveSection, { passive: true })
    window.addEventListener("resize", updateActiveSection)

    if (mobileNav) {
      mobileNav.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", () => mobileNav.removeAttribute("open"))
      })

      document.addEventListener("click", (event) => {
        if (mobileNav.open && event.target instanceof Node && !mobileNav.contains(event.target)) {
          mobileNav.removeAttribute("open")
        }
      })
    }

    langButtons.forEach((button) => {
      button.addEventListener("click", () => {
        const lang = button.dataset.langSwitch === "en" ? "en" : "es"
        localStorage.setItem("site-language", lang)
        applyTranslations(lang)
      })
    })
  })
</script>

<style>
  .mobile-nav > summary::-webkit-details-marker {
    display: none;
  }

  .mobile-nav > summary {
    cursor: pointer;
  }

  .hamburger {
    width: 1.15rem;
    height: 0.95rem;
    display: inline-flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .hamburger .line {
    height: 1.5px;
    width: 100%;
    border-radius: 9999px;
    background-color: currentColor;
    transform-origin: center;
    transition:
      transform 220ms ease,
      opacity 180ms ease;
  }

  .mobile-nav[open] .line-1 {
    transform: translateY(0.41rem) rotate(45deg);
  }

  .mobile-nav[open] .line-2 {
    opacity: 0;
  }

  .mobile-nav[open] .line-3 {
    transform: translateY(-0.41rem) rotate(-45deg);
  }

  /* Estado activo: monocromo, se marca con fondo tinta invertida. */
  .nav-link.is-active,
  .lang-btn.is-active {
    @apply bg-ink font-semibold text-paper;
  }

  .header-nav {
    @apply bg-paper/70;
    animation: nav-appear 1s linear both;
    animation-timeline: scroll();
    animation-range: 0 100px;
  }

  @keyframes nav-appear {
    0% {
      @apply border-transparent bg-paper/0 shadow-none;
    }
    to {
      @apply border-line bg-paper/80 shadow-sm backdrop-blur-md;
    }
  }
</style>
