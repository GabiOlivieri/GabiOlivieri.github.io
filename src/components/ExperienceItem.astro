---
import LinkInline from "./LinkInline.astro"
import ArrowRight from "./icons/ArrowRight.astro"

interface Props {
  title: string
  company: string
  description: string
  link?: string
  date: string
  current?: boolean
  i18nKeyPrefix?: string
}

const { title, company, description, link, date, current = false, i18nKeyPrefix } = Astro.props
---

<div class="relative grid gap-4 border-l border-line pb-12 pl-8 md:grid-cols-5 md:gap-10">
  <!-- Punto del timeline: relleno si es el puesto actual, hueco si es pasado. -->
  <span class="absolute -left-[4.5px] top-1.5 flex size-2 items-center justify-center" aria-hidden="true">
    {current && <span class="absolute inline-flex size-full animate-ping rounded-full bg-ink/40 motion-reduce:animate-none" />}
    <span
      class={`relative inline-flex size-2 rounded-full ${current ? "bg-ink" : "border border-faint bg-paper"}`}
    ></span>
  </span>

  <div class="md:col-span-2">
    <time class="label-code">
      <span data-i18n={i18nKeyPrefix ? `${i18nKeyPrefix}.date` : undefined}>{date}</span>
    </time>
    <h3 class="mt-2 text-lg font-semibold leading-snug text-ink">
      <span data-i18n={i18nKeyPrefix ? `${i18nKeyPrefix}.title` : undefined}>{title}</span>
    </h3>
    <p class="mt-1 font-mono text-sm text-muted">
      <span data-i18n={i18nKeyPrefix ? `${i18nKeyPrefix}.company` : undefined}>{company}</span>
    </p>
  </div>

  <div class="flex flex-col items-start gap-3 text-pretty leading-relaxed text-muted md:col-span-3">
    <span data-i18n={i18nKeyPrefix ? `${i18nKeyPrefix}.description` : undefined}>{description}</span>
    {
      link && (
        <LinkInline href={link}>
          <span data-i18n="experience.moreAbout">Saber más sobre</span>{" "}
          <span data-i18n={i18nKeyPrefix ? `${i18nKeyPrefix}.company` : undefined}>{company}</span>
          <ArrowRight class="size-4" aria-hidden="true" />
        </LinkInline>
      )
    }
  </div>
</div>
