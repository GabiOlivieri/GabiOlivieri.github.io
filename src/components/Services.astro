---
/**
 * Áreas de foco. A propósito son pocas y concretas: la idea es leerse como
 * un profesional con un terreno definido, no como alguien que hace de todo.
 */
const services = [
  {
    id: "product",
    index: "01",
    title: "Plataformas y productos web",
    points: [
      "Aplicaciones full stack de punta a punta: modelo de datos, API, interfaz y puesta en producción.",
      "Refactor y mantenimiento de sistemas ya en uso, sin cortar el servicio a los usuarios.",
    ],
  },
  {
    id: "identity",
    index: "02",
    title: "Identidad, accesos y seguridad",
    points: [
      "Single Sign-On y federación con Keycloak, OpenID Connect y SAML 2.0.",
      "Prácticas DevSecOps integradas al ciclo de desarrollo, no agregadas al final.",
    ],
  },
  {
    id: "cloud",
    index: "03",
    title: "Cloud y DevOps",
    points: [
      "Arquitecturas sobre AWS y Google Cloud, con infraestructura como código.",
      "Contenedores, orquestación y pipelines de despliegue continuo con GitLab CI y Jenkins.",
    ],
  },
  {
    id: "ai",
    index: "04",
    title: "IA generativa aplicada",
    points: [
      "Integración de modelos de lenguaje en productos existentes, con criterio de costo y latencia.",
      "Automatización de flujos internos donde el modelo aporta valor medible.",
    ],
  },
]
---

<section aria-label="Áreas de foco" class="space-y-8">
  <p class="max-w-2xl text-pretty leading-relaxed text-muted" data-i18n="services.intro" data-reveal>
    No hago de todo. Estas son las cuatro áreas donde tengo trabajo entregado, certificaciones que lo
    respaldan y criterio propio para decidir.
  </p>

  <div class="grid gap-px overflow-hidden rounded-2xl border border-line bg-line sm:grid-cols-2" data-reveal-group>
    {
      services.map((service) => (
        <article class="group bg-paper p-6 transition-colors duration-300 hover:bg-surface sm:p-7" data-reveal>
          <div class="flex items-baseline gap-3">
            <span class="font-mono text-sm text-faint transition-colors group-hover:text-ink">
              {service.index}
            </span>
            <h3
              class="text-lg font-semibold leading-tight text-ink"
              data-i18n={`services.${service.id}.title`}
            >
              {service.title}
            </h3>
          </div>

          <ul class="mt-4 space-y-3 text-sm leading-relaxed text-muted">
            {service.points.map((point, pointIndex) => (
              <li class="flex gap-3">
                <span class="mt-[0.55rem] h-px w-4 shrink-0 bg-faint" aria-hidden="true" />
                <span data-i18n={`services.${service.id}.points.${pointIndex}`}>{point}</span>
              </li>
            ))}
          </ul>
        </article>
      ))
    }
  </div>
</section>
