---
import ExperienceItem from "./ExperienceItem.astro"
import experience from "@/data/experience.json"
---

<ol class="relative mt-16" aria-label="Experiencia laboral" data-reveal-group>
  {
    experience.map((exp, i) => (
      <li data-reveal>
        <ExperienceItem {...exp} i18nKeyPrefix={`experience.items.${i}`} />
      </li>
    ))
  }
</ol>
