---
const currentYear = new Date().getFullYear()

const footerLinks = [
  { title: "Experiencia", href: "/#experiencia", i18nKey: "footer.experiencia" },
  { title: "Formación", href: "/#formacion", i18nKey: "footer.formacion" },
  { title: "Servicios", href: "/#servicios", i18nKey: "footer.servicios" },
  { title: "Stack", href: "/#stack", i18nKey: "footer.stack" },
  { title: "Certificaciones", href: "/#certificaciones", i18nKey: "footer.certificaciones" },
  { title: "Proyectos", href: "/#proyectos", i18nKey: "footer.proyectos" },
]
---

<footer class="mt-24 w-full border-t border-line px-4">
  <div
    class="mx-auto flex w-full max-w-6xl flex-col gap-4 py-8 md:flex-row md:items-center md:justify-between"
  >
    <span class="font-mono text-[13px] text-faint">
      &copy; {currentYear} Gabriel Olivieri
    </span>

    <ul class="flex flex-wrap items-center gap-x-5 gap-y-2">
      {
        footerLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class="font-mono text-[13px] text-faint transition-colors hover:text-ink"
            >
              <span data-i18n={link.i18nKey}>{link.title}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</footer>
