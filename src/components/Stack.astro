---
import {
  siDocker,
  siGit,
  siGitlab,
  siGnubash,
  siJavascript,
  siJenkins,
  siKeycloak,
  siKotlin,
  siKubernetes,
  siMariadb,
  siMongodb,
  siNestjs,
  siNextdotjs,
  siNodedotjs,
  siPhp,
  siPostgresql,
  siPython,
  siReact,
  siTerraform,
  siTypescript,
  siVuedotjs,
} from "simple-icons"

type StackIcon = { path: string }
type StackItem = { name: string; icon?: StackIcon; iconSvg?: string }

type StackLevel = {
  id: string
  title: string
  caption: string
  items: StackItem[]
}

// Ícono propio para Java (simple-icons no lo distribuye por licencia).
const javaIconSvg = `<svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path fill="currentColor" d="M8.85 18.6s-.93.55.66.73c1.92.22 2.9.19 5.02-.21 0 0 .56.35 1.34.65-4.75 2.04-10.76-.12-7.02-1.17zm-.58-2.67s-1.04.77.55.94c2.05.21 3.67.23 6.48-.31 0 0 .39.4 1 .61-5.75 1.68-12.15.13-8.03-1.24zM13.15 11.4c1.17 1.35-.31 2.56-.31 2.56s2.97-1.53 1.6-3.45c-1.27-1.79-2.25-2.68 3.04-5.75 0 0-8.31 2.07-4.33 6.64zM19.4 20.58s.69.57-.76 1c-2.75.83-11.46 1.08-13.88.03-.87-.38.76-.9 1.27-1.01.53-.11.84-.09.84-.09-.97-.68-6.26 1.34-2.69 1.92 9.73 1.58 17.74-.71 15.22-1.85zM9.29 13.16s-4.43 1.05-1.57 1.44c1.21.16 3.62.12 5.87-.07 1.84-.15 3.68-.48 3.68-.48s-.65.28-1.12.6c-4.5 1.18-13.18.63-10.68-.58 2.11-1.02 3.82-.91 3.82-.91zm7.95 4.44c4.57-2.38 2.46-4.66.98-4.35-.36.07-.52.14-.52.14s.14-.21.4-.3c2.95-1.04 5.22 3.06-.94 4.63 0 0 .07-.06.08-.12zM14.44 0s2.53 2.53-2.4 6.42c-3.95 3.13-.9 4.91 0 6.95-2.31-2.08-4-3.91-2.87-5.62C10.83 5.24 15.47 4.02 14.44 0z"/></svg>`
const activeDirectoryIconSvg = `<svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path fill="currentColor" d="M12 1.2 2.4 12 12 22.8 21.6 12 12 1.2zm0 4.4a1.9 1.9 0 0 1 1.06 3.48l2.5 2.9a1.9 1.9 0 1 1-1.2 3.06l-2.02 1.78a1.9 1.9 0 1 1-3.2-.46l-1.5-1.36a1.9 1.9 0 1 1-.63-3.2l2.19-2.7A1.9 1.9 0 0 1 12 5.6zm-.9 3.54-2.13 2.66a1.9 1.9 0 0 1 .43 1.9l1.57 1.46a1.9 1.9 0 0 1 2.16.21l2-1.78a1.9 1.9 0 0 1 .17-1.46l-2.6-2.98a1.9 1.9 0 0 1-1.6-.01z"/></svg>`

/**
 * El stack se agrupa por nivel de uso real, no por categoría técnica.
 * Es deliberado: comunica criterio, no un listado de todo lo que se tocó alguna vez.
 */
const stackLevels: StackLevel[] = [
  {
    id: "daily",
    title: "Uso diario",
    caption: "Lo que escribo y opero todas las semanas",
    items: [
      { name: "TypeScript", icon: siTypescript },
      { name: "JavaScript", icon: siJavascript },
      { name: "React", icon: siReact },
      { name: "Next.js", icon: siNextdotjs },
      { name: "Vue.js", icon: siVuedotjs },
      { name: "Node.js", icon: siNodedotjs },
      { name: "NestJS", icon: siNestjs },
      { name: "PostgreSQL", icon: siPostgresql },
      { name: "Docker", icon: siDocker },
      { name: "Git", icon: siGit },
      { name: "GitLab CI", icon: siGitlab },
    ],
  },
  {
    id: "solid",
    title: "Sólido",
    caption: "Proyectos entregados y en producción",
    items: [
      { name: "Java", iconSvg: javaIconSvg },
      { name: "PHP", icon: siPhp },
      { name: "Python", icon: siPython },
      { name: "Bash", icon: siGnubash },
      { name: "Kubernetes", icon: siKubernetes },
      { name: "Keycloak", icon: siKeycloak },
      { name: "Terraform", icon: siTerraform },
      { name: "Jenkins", icon: siJenkins },
      { name: "MariaDB", icon: siMariadb },
    ],
  },
  {
    id: "support",
    title: "De apoyo",
    caption: "Lo uso cuando el problema lo pide",
    items: [
      { name: "Kotlin", icon: siKotlin },
      { name: "MongoDB", icon: siMongodb },
      { name: "Active Directory", iconSvg: activeDirectoryIconSvg },
    ],
  },
]
---

<div class="space-y-10" data-reveal-group>
  {
    stackLevels.map((level) => (
      <section class="grid gap-5 md:grid-cols-[minmax(0,14rem)_minmax(0,1fr)] md:gap-10" data-reveal>
        <div>
          <h3 class="font-mono text-sm font-semibold text-ink">
            <span data-i18n={`stackCards.${level.id}.title`}>{level.title}</span>
          </h3>
          <p class="mt-1 text-sm leading-relaxed text-faint">
            <span data-i18n={`stackCards.${level.id}.caption`}>{level.caption}</span>
          </p>
        </div>

        <ul class="flex flex-wrap gap-2 self-start">
          {level.items.map((item) => (
            <li>
              <span class="group inline-flex items-center gap-2 rounded-lg border border-line bg-surface/60 px-3 py-2 font-mono text-[13px] text-muted transition hover:border-ink hover:text-ink">
                {item.icon ? (
                  <svg class="size-4 opacity-60 transition-opacity group-hover:opacity-100" viewBox="0 0 24 24" aria-hidden="true">
                    <path fill="currentColor" d={item.icon.path} />
                  </svg>
                ) : (
                  <span class="stack-icon size-4 opacity-60 transition-opacity group-hover:opacity-100" set:html={item.iconSvg} />
                )}
                {item.name}
              </span>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</div>

<style>
  .stack-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .stack-icon :global(svg) {
    width: 100%;
    height: 100%;
    display: block;
  }
</style>
